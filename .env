# general
TZ=
PUID=1000
PGID=1000
# run: getent group docker | cut -d: -f3
DOCKER_GID=
PROXMOX_IP=

# universal login (avoid @ : / ? # % $ in the password, it breaks URLs and DSNs)
UNIUSER=
UNIPASS=

# paths
APPDATA=/srv/appdata
SAS_2TB_1=
SATA_4TB_1=
SATA_4TB_2=
SATA_8TB_3=

# versions
# set NEXTCLOUD_TAG to the major your Arch install runs, e.g. 31-apache
NEXTCLOUD_TAG=31-apache
SYNAPSE_TAG=latest
AUTHENTIK_TAG=2026.8.3
IMMICH_VERSION=release

# generate once: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

#iDirac
IDRAC_IP=

#authentik
GRAFANA_OIDC_ID=
GRAFANA_OIDC_SECRET=
ACTUAL_OIDC_ID=
ACTUAL_OIDC_SECRET=

